{
  "site": {
    "base_url": "https://www.bidding.csg.cn",
    "list_path": "/ggxx/index.jhtml",
    "page_path": "/ggxx/index_{page}.jhtml",
    "max_pages": 3
  },
  "keywords": {
    "include": [
      "报废",
      "拍卖",
      "报废物资",
      "拍卖会"
    ],
    "exclude": [],
    "match_mode": "any",
    "fetch_detail": true,
    "detail_max_items": 40
  },
  "push": {
    "channels": [],
    "title_prefix": "【南网招标】",
    "max_items_per_message": 5
  },
  "history": {
    "retention_days": 180,
    "max_entries": 10000,
    "first_run_silent": true
  },
  "request": {
    "timeout": 20,
    "retries": 3,
    "delay_seconds": 0.8
  }
}
